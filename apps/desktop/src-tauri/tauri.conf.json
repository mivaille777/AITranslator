{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AITranslator",
  "version": "0.1.0",
  "identifier": "io.github.mivaille777.aitranslator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AITranslator WebReBuild",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "AITranslator Overlay",
        "url": "index.html?view=overlay",
        "width": 420,
        "height": 190,
        "minWidth": 320,
        "minHeight": 184,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "theme": "Dark",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
