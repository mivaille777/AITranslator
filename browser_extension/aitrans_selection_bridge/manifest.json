{
  "manifest_version": 3,
  "name": "AITrans Selection Bridge",
  "version": "0.1.0",
  "description": "Send selected webpage text and reading context to the local AITrans desktop companion.",
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
